# Copy to .env (git-ignored) and fill in. The server reads it at start.
# Azure OpenAI as the clinical reasoner. Without a key, the server uses the no-LLM fallback.
AZURE_API_KEY=
# The Azure OpenAI resource name: https://<name>.openai.azure.com
AZURE_RESOURCE_NAME=
# The deployment name in that resource (required for Azure).
LLM_MODEL=
# Optional: the model behind the deployment (for example gpt-5), to detect reasoning support.
AZURE_MODEL_ID=
# azure | ollama | none. Default: azure when AZURE_API_KEY is set, else none.
# ollama arrives in milestone 2; until then it means no LLM.
LLM_PROVIDER=
# Optional, reasoning models only: none | minimal | low | medium | high | xhigh
LLM_EFFORT=
