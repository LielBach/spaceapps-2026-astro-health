# Copy to .env (git-ignored) and fill in. The server reads it at start.
# Claude as the clinical reasoner. Without a key, the server uses the no-LLM fallback.
ANTHROPIC_API_KEY=
# anthropic | ollama | none. Default: anthropic when ANTHROPIC_API_KEY is set, else none.
# ollama: the offline model is the only reasoner (no link to Earth at all).
LLM_PROVIDER=
# Default: claude-opus-5-5
LLM_MODEL=
# low | medium | high | xhigh | max. Default: medium
LLM_EFFORT=

# Offline model (milestone 2, ADR 0004, docs/technical/12). Used during a comm blackout, or always
# with LLM_PROVIDER=ollama. Without it, a blackout uses the no-LLM fallback.
# Start Ollama with a context large enough for the catalog prompt:
#   OLLAMA_CONTEXT_LENGTH=32768 OLLAMA_MAX_LOADED_MODELS=1 ollama serve
OFFLINE_LLM_MODEL=
# gpt-oss only: low | medium | high
OFFLINE_LLM_REASONING=
# Default: http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=
# The context length Ollama runs with; the server warns when a prompt comes near it. Default: 32768
OLLAMA_CONTEXT_LENGTH=
# Abort a reasoner call after this long and use the fallback. Default: 90000
REASONER_TIMEOUT_MS=
