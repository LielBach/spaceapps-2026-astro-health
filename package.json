{
  "name": "astrohealth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @astrohealth/server dev",
    "dev:web": "pnpm --filter @astrohealth/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check:sources": "tsx scripts/check-sources.ts",
    "data:fetch": "tsx scripts/fetch-raw.ts",
    "data:build": "tsx scripts/build-anchors.ts",
    "record:demos": "tsx scripts/record-demos.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:sources && pnpm check:terminology",
    "check:terminology": "tsx scripts/check-terminology.ts"
  },
  "devDependencies": {
    "@astrohealth/core": "workspace:*",
    "@astrohealth/data": "workspace:*",
    "@eslint/js": "9.30.0",
    "@types/node": "22.15.34",
    "eslint": "9.30.0",
    "globals": "16.3.0",
    "playwright-core": "^1.65.1",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4",
    "yaml": "2.8.0",
    "zod": "3.25.76"
  }
}
